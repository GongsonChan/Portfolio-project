# Copy this file to .env (same folder) and fill in real values. .env is gitignored -- never
# commit real secrets. Every module reads this one file (db.py's load_dotenv always points
# here), so there's only ever this single .env to set up.

# Must match docker-compose.yml's db service -- pick anything, these just create the local
# Postgres user/db on first container init.
POSTGRES_USER=smallfunds
POSTGRES_PASSWORD=smallfunds
POSTGRES_DB=smallfunds

# Only needed if the DB isn't on localhost:5432 (docker-compose.yml's default). Uncomment to
# override.
# DB_HOST=localhost
# DB_PORT=5432

# KRX Open API key (KOSPI/KOSDAQ price + listing data) -- register at
# https://data-dbg.krx.co.kr (무료, 카테고리별 별도 승인 필요, 보통 1일 내).
KRX_API=

# Anthropic API key (used by 06_post_filter's LLM sector classification) -- get one at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# DART (OpenDART) API key (10_equity_research's company filings + financial statements) --
# register for free at https://opendart.fss.or.kr.
DART_API_KEY=

# Naver news search (10_equity_research's news lookup) -- from NAVER API HUB
# (https://api.ncloud-docs.com/docs/naver-api-hub-overview), NOT the older developers.naver.com
# Open API -- the two are separate products with different endpoints/header names, and keys from
# one 401 on the other's endpoint (see 10_equity_research/DESIGN.md's "알려진 버그/교훈").
# Client ID + Client Secret pair, both required.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
